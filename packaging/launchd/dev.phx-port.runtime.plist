<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.phx-port.runtime</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/install -d -o phx-port -g phx-port-admin -m 0750 /private/var/run/phx-port &amp;&amp; /usr/bin/install -d -o phx-port -g phx-port -m 0700 /private/var/run/phx-port/handoff</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/var/log/phx-port-runtime.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/phx-port-runtime.log</string>
</dict>
</plist>
